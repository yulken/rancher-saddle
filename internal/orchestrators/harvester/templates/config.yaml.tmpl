# Generated by rancher-tui — Harvester install config for {{ .Name }} ({{ .Role }}).
scheme_version: 1
token: {{ .Token }}
os:
  hostname: {{ .Name }}
  password: {{ .Password }}
  ntp_servers:
{{- range .NTPServers }}
    - {{ . }}
{{- end }}
install:
{{- if eq .Role "create" }}
  mode: create
{{- else }}
  mode: join
  server_url: https://{{ .VIP }}:443
{{- end }}
  management_interface:
    interfaces:
      - name: {{ .MgmtInterface }}
    method: dhcp
    bond_options:
      mode: balance-tlb
      miimon: 100
  vip: {{ .VIP }}
  vip_mode: {{ .VIPMode }}
  device: /dev/vda
  iso_url: {{ .ISOURL }}
system_settings:
  ntp-servers: '{"ntpServers":[{{ range $i, $s := .NTPServers }}{{ if $i }},{{ end }}"{{ $s }}"{{ end }}]}'
