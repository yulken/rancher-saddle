<!-- Generated by rancher-tui — isolated NAT network for Harvester cluster "{{ .ClusterName }}". -->
<network>
  <name>harvester-{{ .ClusterName }}</name>
  <forward mode='nat'/>
  <ip address='{{ .Gateway }}' netmask='255.255.255.0'>
    <dhcp>
      <range start='{{ .DHCPStart }}' end='{{ .DHCPEnd }}'/>
{{- range .Nodes }}
      <host mac='{{ .MAC }}' name='{{ .Name }}' ip='{{ .IP }}'/>
{{- end }}
    </dhcp>
  </ip>
</network>
